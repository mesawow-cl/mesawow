// mesawow · configuración de Cloudflare Workers
// Local: `npm run dev` (Vite + Workers). Staging y production se completan en la Fase 8
// con los IDs reales de `wrangler d1 create` y `wrangler r2 bucket create`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mesawow",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Cada 5 minutos: automatizaciones al aire. Lunes 10:00 UTC: feriados oficiales de Chile.
  "triggers": { "crons": ["*/5 * * * *", "0 10 * * 1"] },
  "vars": {
    "ENTORNO": "local",
    "APP_URL": "http://localhost:5173",
    // Cloudflare Access (Zero Trust). Vacíos en local: se usa "Entrar como".
    "ACCESS_EQUIPO": "",
    "ACCESS_AUD": "",
    // ID de cliente OAuth de Google Calendar (no es secreto). El secreto va en GOOGLE_CLIENT_SECRET.
    "GOOGLE_CLIENT_ID": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mesawow-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVOS", "bucket_name": "mesawow-archivos-local" }
  ],
  "env": {
    "staging": {
      "name": "mesawow-staging",
      "vars": { "ENTORNO": "staging", "APP_URL": "https://staging.mesawow.cl", "ACCESS_EQUIPO": "", "ACCESS_AUD": "", "GOOGLE_CLIENT_ID": "" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mesawow-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "ARCHIVOS", "bucket_name": "mesawow-archivos-staging" }
      ]
    },
    "production": {
      "name": "mesawow",
      "vars": { "ENTORNO": "production", "APP_URL": "https://app.mesawow.cl", "ACCESS_EQUIPO": "", "ACCESS_AUD": "", "GOOGLE_CLIENT_ID": "" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mesawow-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "ARCHIVOS", "bucket_name": "mesawow-archivos-production" }
      ]
    }
  }
}
