// mesawow · configuración de Cloudflare Workers
// Local: `npm run dev` (Vite + Workers). Staging y production se completan en la Fase 8
// con los IDs reales de `wrangler d1 create` y `wrangler r2 bucket create`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mesawow",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Cada 5 minutos: automatizaciones al aire. Lunes 10:00 UTC: feriados oficiales de Chile.
  "triggers": { "crons": ["*/5 * * * *", "0 10 * * 1", "0 11 * * *"] },
  "vars": {
    "ENTORNO": "local",
    "APP_URL": "http://localhost:5173",
    // Cloudflare Access (Zero Trust). Vacíos en local: se usa "Entrar como".
    "ACCESS_EQUIPO": "",
    "ACCESS_AUD": "",
    // ID de cliente OAuth de Google Calendar (no es secreto). El secreto va en GOOGLE_CLIENT_SECRET.
    "GOOGLE_CLIENT_ID": "",
    // Avisos (Fase 6). Secretos aparte: BREVO_API_KEY, BREVO_WEBHOOK_CLAVE, VAPID_PRIVADA.
    "BREVO_REMITENTE": "mesawow.cl@gmail.com",
    "BREVO_REMITENTE_NOMBRE": "mesawow",
    "WHATSAPP_REMITENTE": "",
    "WHATSAPP_PLANTILLA_ID": "",
    "VAPID_PUBLICA": "BMC6HWLNtSgijacHZR56vZcspAGj9J0ABQl9IoY5NNRpYqHF4XvQU9Urv_ASCLnrqnS83gUZ7bJdVh7XySgXXEY",
    "VAPID_CONTACTO": "mailto:mesawow.cl@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mesawow-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVOS", "bucket_name": "mesawow-archivos-local" }
  ],
  // En vivo: una sala con WebSocket Hibernation para el Inicio, la campana y los calendarios.
  "durable_objects": { "bindings": [{ "name": "VIVO", "class_name": "SalaEnVivo" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SalaEnVivo"] }],
  // Cola de avisos por canal (correo, WhatsApp, push), con reintentos.
  "queues": {
    "producers": [{ "binding": "AVISOS", "queue": "mesawow-avisos-local" }],
    "consumers": [{ "queue": "mesawow-avisos-local", "max_batch_size": 20, "max_batch_timeout": 2, "max_retries": 5 }]
  },
  "env": {
    "staging": {
      "name": "mesawow-staging",
      "vars": { "ENTORNO": "staging", "APP_URL": "https://staging.mesawow.cl", "ACCESS_EQUIPO": "", "ACCESS_AUD": "", "GOOGLE_CLIENT_ID": "", "BREVO_REMITENTE": "mesawow.cl@gmail.com", "BREVO_REMITENTE_NOMBRE": "mesawow", "WHATSAPP_REMITENTE": "", "WHATSAPP_PLANTILLA_ID": "", "VAPID_PUBLICA": "", "VAPID_CONTACTO": "mailto:mesawow.cl@gmail.com" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mesawow-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "ARCHIVOS", "bucket_name": "mesawow-archivos-staging" }
      ],
      "durable_objects": { "bindings": [{ "name": "VIVO", "class_name": "SalaEnVivo" }] },
      "queues": {
        "producers": [{ "binding": "AVISOS", "queue": "mesawow-avisos-production" }],
        "consumers": [{ "queue": "mesawow-avisos-production", "max_batch_size": 20, "max_batch_timeout": 2, "max_retries": 5 }]
      },
      "queues": {
        "producers": [{ "binding": "AVISOS", "queue": "mesawow-avisos-staging" }],
        "consumers": [{ "queue": "mesawow-avisos-staging", "max_batch_size": 20, "max_batch_timeout": 2, "max_retries": 5 }]
      }
    },
    "production": {
      "name": "mesawow",
      "vars": { "ENTORNO": "production", "APP_URL": "https://app.mesawow.cl", "ACCESS_EQUIPO": "", "ACCESS_AUD": "", "GOOGLE_CLIENT_ID": "", "BREVO_REMITENTE": "mesawow.cl@gmail.com", "BREVO_REMITENTE_NOMBRE": "mesawow", "WHATSAPP_REMITENTE": "", "WHATSAPP_PLANTILLA_ID": "", "VAPID_PUBLICA": "", "VAPID_CONTACTO": "mailto:mesawow.cl@gmail.com" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mesawow-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "ARCHIVOS", "bucket_name": "mesawow-archivos-production" }
      ],
      "durable_objects": { "bindings": [{ "name": "VIVO", "class_name": "SalaEnVivo" }] }
    }
  }
}
